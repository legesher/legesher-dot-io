---
import { getEntry, render } from 'astro:content';

import LegalLayout from '../layouts/LegalLayout.astro';
import LegalTable from '../components/LegalTable.astro';
import { LAST_UPDATED } from '@/lib/page-dates.mjs';

// The text is src/content/legal/privacy.mdx; the layout is LegalLayout.
const entry = await getEntry('legal', 'privacy');
if (!entry) throw new Error('src/content/legal/privacy.mdx is missing');
const { Content, headings } = await render(entry);
---

<LegalLayout entry={entry} headings={headings} lastUpdated={LAST_UPDATED.privacy} pageTitle="Privacy Policy — Legesher">
  <Content components={{ table: LegalTable }} />
</LegalLayout>
