            <thead>
              <tr>
                <th>Asset</th>
                <th>License</th>
                <th>Your rights</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>VS Code extension code</td>
                <td>Apache 2.0</td>
                <td>Use, modify, distribute, include in commercial products &mdash; subject only to Apache 2.0
                  terms</td>
              </tr>
              <tr>
                <td>Language pack code</td>
                <td>Apache 2.0</td>
                <td>Same</td>
              </tr>
              <tr>
                <td>Core engine and CLI</td>
                <td>Apache 2.0</td>
                <td>Same</td>
              </tr>
