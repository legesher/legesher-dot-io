---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ButtonLink from '../components/ButtonLink.astro';
import InstallDemo from '../components/InstallDemo.astro';
import { Card, CardHeader, CardContent, CardTitle, CardDescription } from '@/components/ui/card';
import { LINKS } from '@/lib/links';
import { LAST_UPDATED, formatLastUpdated } from '@/lib/page-dates.mjs';
import { PRODUCTS } from '@/lib/products';

const lastUpdated = formatLastUpdated(LAST_UPDATED.install);
const live = PRODUCTS.filter((product) => product.status === 'live');
// The page leads with a product reached through a Legesher account once it is
// live; the open-source installs follow as the second row.
const account = live.filter((product) => product.kind === 'account');
const openSource = live.filter((product) => product.kind === 'open-source');
const coming = PRODUCTS.filter((product) => product.status === 'coming');

// The lede names the "Coming" section only while the page has one.
const lede =
  coming.length > 0
    ? 'Every Legesher product in one place: what you can use today, where to get it, and what is still on its way.'
    : 'Every Legesher product in one place: what you can use today and where to get it.';

const linkClass = 'font-semibold text-brand-cyan hover:text-brand-coral transition-colors duration-300';
// Commands read as a terminal, the same dark surface as the editor on the home page.
// A long command wraps inside its box instead of hiding its end: each command is its
// own block with a hanging indent, so a wrapped line sits under the command, not under
// the prompt mark. The wrap is visual only; the copied text keeps one line per command.
const commandClass =
  'min-w-0 rounded-md border border-gray-800 bg-[#1E1E1E] p-4 font-noto-mono text-sm leading-relaxed text-gray-100 whitespace-pre-wrap [overflow-wrap:anywhere]';
const commandLineClass = 'block ps-[2ch] [text-indent:-2ch]';
---

<Layout title="Install Legesher" description={lede}>
  <Header />
  <main class="pt-32 pb-20 bg-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <header class="mb-12 max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Install Legesher</h1>
        <p class="text-lg text-muted-foreground mb-2">
          {lede}
          {coming.length > 0 && ' When a product is ready to install, its command appears here.'}
        </p>
        <p class="text-sm text-muted-foreground">Last updated: {lastUpdated}</p>
      </header>

      {account.map((product) => (
        <section aria-labelledby={`${product.id}-account`} class="mb-16">
          <div id={product.id} class="rounded-lg border-2 border-brand-cyan shadow-sm p-6 md:p-10 grid md:grid-cols-2 gap-8 md:gap-x-12">
            <div class="flex flex-col gap-4 min-w-0">
              <span class="inline-block self-start text-xs font-semibold uppercase tracking-wide text-brand-cyan">
                Start here
              </span>
              <h2 id={`${product.id}-account`} class="text-2xl md:text-3xl font-bold">Create your Legesher account</h2>
              <p class="text-base text-muted-foreground">
                Your account is free. It comes with a key for the {product.name}.
              </p>
              <ol class="list-decimal ps-5 space-y-1 text-base">
                {product.steps?.map((step) => <li>{step}</li>)}
              </ol>
              {product.access && (
                <ButtonLink href={product.access.href} variant="default" size="lg" class="primary-button self-start mt-2">
                  {product.access.label}
                </ButtonLink>
              )}
            </div>
            <div class="flex flex-col gap-4 min-w-0">
              {product.demo && <InstallDemo demo={product.demo} name={product.name} class="rounded-lg border border-gray-800 overflow-hidden" />}
              <h3 class="text-2xl font-semibold leading-none tracking-tight">{product.name}</h3>
              <p class="text-base text-muted-foreground">{product.summary}</p>
              {product.stage && <p class="text-sm text-muted-foreground">{product.stage}</p>}
            </div>
            {product.commands && (
              <pre class:list={['md:col-span-2', commandClass]}><code>{product.commands.map((command) => (<span class={commandLineClass}><span class="select-none text-brand-cyan">$ </span>{command}</span>))}</code></pre>
            )}
          </div>
        </section>
      ))}

      <section aria-labelledby="open-source" class="mb-16">
        <h2 id="open-source" class="text-2xl md:text-3xl font-bold mb-2">Open source</h2>
        <p class="text-muted-foreground mb-6 max-w-3xl">
          You can install these without an account. Each one links to its source.
        </p>
        <div class="grid md:grid-cols-2 gap-8">
          {openSource.map((product) => (
            <Card id={product.id} className="flex flex-col min-w-0 overflow-hidden">
              {product.demo && <InstallDemo demo={product.demo} name={product.name} />}
              <CardHeader>
                <span class="inline-block self-start text-xs font-semibold uppercase tracking-wide text-brand-cyan mb-2">
                  Available now
                </span>
                <CardTitle>{product.name}</CardTitle>
              </CardHeader>
              <CardContent className="flex flex-col gap-4 flex-1">
                <CardDescription className="text-base">{product.summary}</CardDescription>
                {product.stage && <p class="text-sm text-muted-foreground">{product.stage}</p>}
                {product.commands && (
                  <pre class={commandClass}><code>{product.commands.map((command) => (<span class={commandLineClass}><span class="select-none text-brand-cyan">$ </span>{command}</span>))}</code></pre>
                )}
                {product.access && (
                  <a href={product.access.href} target="_blank" rel="noopener noreferrer" class:list={['mt-auto', linkClass]}>
                    {product.access.label}
                  </a>
                )}
                {product.alsoAt?.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    {link.label}
                  </a>
                ))}
                {product.source && (
                  <a href={product.source.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    {product.source.label}
                  </a>
                )}
              </CardContent>
            </Card>
          ))}
        </div>
      </section>

      {coming.length > 0 && (
        <section aria-labelledby="coming" class="mb-16">
          <h2 id="coming" class="text-2xl md:text-3xl font-bold mb-2">Coming</h2>
          <p class="text-muted-foreground mb-6 max-w-3xl">
            These products are built and are being prepared for release. Each one says what it is
            waiting on.
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {coming.map((product) => (
              <Card id={product.id} className="flex flex-col">
                <CardHeader>
                  <span class="inline-block self-start text-xs font-semibold uppercase tracking-wide text-brand-coral mb-2">
                    Coming
                  </span>
                  <CardTitle>{product.name}</CardTitle>
                </CardHeader>
                <CardContent className="flex flex-col gap-4 flex-1">
                  <CardDescription className="text-base">{product.summary}</CardDescription>
                  <p class="text-sm text-muted-foreground mt-auto">{product.arrives}</p>
                </CardContent>
              </Card>
            ))}
          </div>
        </section>
      )}

      <section aria-labelledby="release-updates" class="max-w-3xl">
        <h2 id="release-updates" class="text-2xl md:text-3xl font-bold mb-4">Hear about releases</h2>
        <p class="text-muted-foreground mb-4">
          Documentation is at <a href={LINKS.docs} class="text-brand-cyan hover:text-brand-coral transition-colors duration-300">docs.legesher.io</a>.
          Releases are announced in the newsletter first, and the open-source code is on
          <a href={LINKS.github} class="text-brand-cyan hover:text-brand-coral transition-colors duration-300">GitHub</a>.
        </p>
        <a href="/#newsletter" class="font-semibold text-brand-cyan hover:text-brand-coral transition-colors duration-300">Join the newsletter</a>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script src="/scripts/install-demos.js" is:inline></script>
