---
import { getEntry, render } from 'astro:content';

import LegalLayout from '../layouts/LegalLayout.astro';
import { LAST_UPDATED } from '@/lib/page-dates.mjs';

// The text is src/content/legal/refunds.mdx; the layout is LegalLayout.
const entry = await getEntry('legal', 'refunds');
if (!entry) throw new Error('src/content/legal/refunds.mdx is missing');
const { Content, headings } = await render(entry);
---

<LegalLayout entry={entry} headings={headings} lastUpdated={LAST_UPDATED.refunds} pageTitle="Refund and Cancellation Policy - Legesher">
  <Content />
</LegalLayout>
