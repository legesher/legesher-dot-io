<style>
  /* Language windows: every pane sits in one grid cell; the script moves
     is-active along. Without the script the first pane simply stays. */
  /* The outgoing pane fades out before the next fades in, so two programs
     (one of them right-to-left, perhaps) never show on top of each other. */
  /* Hidden panes share the visible pane's grid cell, so they also become
     visibility: hidden once faded out. Otherwise the topmost invisible pane
     would take the taps, scrolls and text selection meant for the visible one. */
  .rotator-pane {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
  }
  .rotator-pane.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease 0.25s, visibility 0s linear 0.25s;
  }
  .rotator-toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.4);
    color: #d1d5db;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
  }
  .language-pill[aria-pressed='true'] {
    border-color: #ec6756;
    background: #ec6756;
    color: #fff;
  }
  .rotator-toggle:hover,
  .rotator-toggle:focus-visible {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* The light bulb above "think". */
  .bulb {
    display: inline-block;
    margin-left: 0.1em;
    font-size: 0.8em;
    transform: translateY(-0.35em) rotate(12deg);
    animation: bulb-glow 3s ease-in-out infinite;
  }
  @keyframes bulb-glow {
    0%, 100% { filter: drop-shadow(0 0 0 rgba(246, 241, 111, 0)); }
    50% { filter: drop-shadow(0 0 0.3em rgba(246, 241, 111, 0.9)); }
  }

  /* Problem statement: a keyboard drawn after the deck's keyboard photo, as
     a seamless tile (every row fills the tile exactly), so it repeats at a
     small key size with no visible edges. */
  .keyboard-backdrop {
    background: url('/education/keyboard.svg') 0 0 / 368px auto repeat;
    opacity: 0.16;
  }

  /* The deck's Ctrl key photo with its coral glow. */
  .ctrl-key {
    width: min(20rem, 64vw);
    height: auto;
    filter: drop-shadow(0 0 28px rgba(236, 103, 86, 0.55)) drop-shadow(0 0 80px rgba(236, 103, 86, 0.3));
  }

  @media (prefers-reduced-motion: reduce) {
    .bulb { animation: none; }
    .rotator-pane, .rotator-pane.is-active { transition: none; }
  }
</style>

<script>
  // Steps each language window to its next pane. Reduced motion starts it
  // paused; the button pauses and resumes (WCAG 2.2.2).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-rotator]').forEach((root) => {
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-pane]'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-rotator-toggle]');
    // Pills elsewhere on the page that pick a pane in this window.
    const pills = root.id
      ? Array.from(document.querySelectorAll<HTMLButtonElement>(`[data-rotator-pill="${root.id}"]`))
      : [];
    if (panes.length < 2) return;

    const interval = Number(root.dataset.interval) || 3500;
    let index = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      panes[index].classList.remove('is-active');
      panes[index].setAttribute('aria-hidden', 'true');
      pills[index]?.setAttribute('aria-pressed', 'false');
      index = next;
      panes[index].classList.add('is-active');
      panes[index].removeAttribute('aria-hidden');
      pills[index]?.setAttribute('aria-pressed', 'true');
    };
    const start = () => {
      timer = window.setInterval(() => show((index + 1) % panes.length), interval);
      if (toggle) toggle.textContent = 'Pause';
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
      if (toggle) toggle.textContent = 'Play';
    };

    // Choosing a language shows it and holds it there; Play carries on from it.
    pills.forEach((pill) =>
      pill.addEventListener('click', () => {
        stop();
        show(Number(pill.dataset.index) || 0);
      }),
    );

    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => (timer === undefined ? start() : stop()));
    }
    if (reduceMotion) {
      if (toggle) toggle.textContent = 'Play';
    } else {
      start();
    }
  });
</script>
