---
// Attendee link hub for Hacktoberfest Hack Day Dubai x Legesher (Friday 30 October 2026).
// One page, one QR code: every link an attendee needs on the day, so the slides do not
// have to carry a QR code per link. Built from the same sections, cards and buttons as
// the homepage, with no client script, so it sits inside the site's Content Security
// Policy without changes. The event code is deliberately not published here.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { Card, CardHeader, CardContent, CardTitle, CardDescription } from '@/components/ui/card';
import { LINKS } from '@/lib/links';

const EVENT_PAGE = 'https://www.mlh.com/events/hacktoberfest-hack-day-dubai-x-legesher';
const CHALLENGE = (id: string) => `${EVENT_PAGE}/challenges/${id}`;

type LinkCard = { icon: string; title: string; text: string; href: string; url: string };

const checkIn: LinkCard[] = [
  {
    icon: '✅',
    title: 'Check in with MLH',
    text: 'Check in on the MLH website when you arrive.',
    href: 'https://www.mlh.com/checkin',
    url: 'mlh.com/checkin',
  },
  {
    icon: '🤖',
    title: 'Check in with your AI agent',
    text: 'Install DevRelay, connect MLH, then ask your agent: "Check me in to this Fest." Your organizers will share the event code in the room.',
    href: 'https://devrelay.com',
    url: 'devrelay.com',
  },
];

const schedule = [
  { time: '2:30 PM', label: 'Check-in, team forming and creative activities' },
  { time: '3:00 PM', label: 'Opening ceremony' },
  { time: '3:30 PM', label: 'Hacking begins' },
  { time: 'During hacking', label: 'Meal time' },
  { time: '7:00 PM', label: 'Project submission deadline, demos and judging', highlight: true },
  { time: '7:45 PM', label: 'Winners announced and group photo' },
];

const submit: LinkCard[] = [
  {
    icon: '🚀',
    title: 'Submit your project on MLH',
    text: 'Add your project and tag every challenge you are entering.',
    href: EVENT_PAGE,
    url: 'mlh.com/events/hacktoberfest-hack-day-dubai-x-legesher',
  },
  {
    icon: '✍️',
    title: 'Write it up on DEV',
    text: 'Share your build through DEV Challenges for promo credits and sponsor prizes.',
    href: 'https://mlh.link/dev-hacktoberfest',
    url: 'mlh.link/dev-hacktoberfest',
  },
];

const challenges = [
  {
    icon: '🔓',
    sponsor: 'MLH and DEV',
    title: 'Best Open-Source AI Project',
    body: 'Build an original project that uses open-source or open-weight AI. Your project link must be a public GitHub repo with an open-source license.',
    prize: 'Exclusive Hacktoberfest 2026 Winner DEV Badge and an MLH Swag Bag',
    details: CHALLENGE('01a0d987-0c41-12ea-13ac-5b85755dc2f3'),
    resources: [{ label: 'mlh.com/opensource-ai', href: 'https://mlh.com/opensource-ai' }],
  },
  {
    icon: '💎',
    sponsor: 'Google DeepMind',
    title: 'Best Use of Gemma 4',
    body: "Build with Gemma 4, Google's lightweight open-weights model, through the Gemini API.",
    prize: 'MLH and DEV Swag Bag',
    details: CHALLENGE('01a03b87-be22-9180-5e2d-b3beeb66666d'),
    resources: [
      { label: 'Gemma quick start', href: 'https://mlh.link/gemma' },
      { label: 'Try the demo', href: 'https://mlh.link/hackdays-gemma-demo' },
      { label: 'Gemma Cookbook', href: 'https://github.com/google-gemma/cookbook' },
    ],
  },
  {
    icon: '🌍',
    sponsor: 'Legesher',
    title: 'Best Innovation in Your Language',
    body: "Build something new for the people who speak your language. It has to work meaningfully in at least one language other than English, and your demo should show it. Coding in your own language is strongly encouraged: Legesher's open-source language packs let you write Python in Español (Spanish) with definir and imprimir, or in your own language. They are welcome but not required, and they are experimental, with community validation underway.",
    prize: 'Legesher T-shirt, an exclusive sticker and access to the Legesher Founding Developer Program',
    details: CHALLENGE('01a12f8d-fc19-5768-9ac5-b0e340255f19'),
    resources: [
      { label: 'Contribute your language', href: 'https://github.com/legesher/language-packs' },
      { label: 'Try the demo', href: 'https://github.com/legesher/legesher' },
    ],
  },
  {
    icon: '🛡️',
    sponsor: 'CysuiteONE',
    title: 'Family Footprint Challenge',
    body: "Scammers don't need to hack a family. They just need what is already public. Build a tool that shows a family what a scammer could find, then gives parents a clear list of fixes, explained in Arabic and English. Start from the open-source Python starter kit. All data is synthetic, and the rules require self-scan only, with consent first.",
    prize: 'One mentoring session with Marta de Zavala, founder of CysuiteONE',
    details: CHALLENGE('01a1892e-ce11-41fe-552f-c400277dbe5b'),
    resources: [{ label: 'Family Footprint on GitHub', href: 'https://github.com/mdzavala/family-footprint' }],
  },
];

const perks: LinkCard[] = [
  {
    icon: '🎁',
    title: 'Free credits from partners',
    text: 'Every Hacktoberfest offer, in one place.',
    href: 'https://hacktoberfest.com/my/promos',
    url: 'hacktoberfest.com/my/promos',
  },
  {
    icon: '💬',
    title: 'MLH Community Discord',
    text: 'Meet more than 100,000 other hackers.',
    href: 'https://mlh.link/Discord',
    url: 'mlh.link/Discord',
  },
  {
    icon: '⭐',
    title: 'Your Hacktoberfest stickers',
    text: 'Earn virtual stickers by learning and building. They unlock real swag.',
    href: 'https://hacktoberfest.com/my',
    url: 'hacktoberfest.com/my',
  },
  {
    icon: '📅',
    title: 'The rest of Hacktoberfest',
    text: 'Global Hack Week live builds, online challenges and a new DEV challenge every Monday.',
    href: 'https://hacktoberfest.com/schedule',
    url: 'hacktoberfest.com/schedule',
  },
];

const legesher: LinkCard[] = [
  {
    icon: '🤝',
    title: 'Join the community on Slack',
    text: 'Build alongside 250+ open source contributors from 30+ countries.',
    href: LINKS.slack,
    url: 'legesher.io/go/slack',
  },
  {
    icon: '📦',
    title: 'Legesher language packs on GitHub',
    text: 'The open-source packs behind writing Python in your own language. They are experimental, with community validation underway.',
    href: 'https://github.com/legesher/language-packs',
    url: 'github.com/legesher/language-packs',
  },
];

const MLH_CODE_OF_CONDUCT = 'https://static.mlh.io/docs/mlh-code-of-conduct.pdf';

const help: LinkCard[] = [
  {
    icon: '📜',
    title: 'MLH Code of Conduct',
    text: 'MLH events are a safe space for everyone. Please read it before you build.',
    href: MLH_CODE_OF_CONDUCT,
    url: 'static.mlh.io/docs/mlh-code-of-conduct.pdf',
  },
];

// Matches the homepage feature cards in Features.astro.
const cardClass =
  'h-full bg-[#2d2d2d] border-[#424242] text-white transition-all duration-300 group-hover:shadow-lg group-hover:scale-[1.02] group-hover:border-brand-light-cyan';
const tileClass =
  'w-12 h-12 rounded-lg bg-brand-background-coral/80 flex items-center justify-center mb-4 text-2xl group-hover:bg-brand-background-coral transition-colors duration-300';
---

<Layout
  title="Hacktoberfest Hack Day Dubai x Legesher"
  description="Every link for Hacktoberfest Hack Day Dubai x Legesher: check-in, schedule, challenges, submissions and perks."
>
  <!-- Dark-only page: the shared Header and Footer are light by default, so these
       wrappers recolor them here without changing the components site-wide. -->
  <div class="[&_#main-header:not(.bg-white)]:text-white [&_#mobile-menu]:text-neutral-900">
    <Header />
  </div>
  <main>
    <section class="pt-32 pb-20 bg-[#272727] bg-[radial-gradient(circle_at_right,rgba(108,197,224,0.28)_0%,rgba(108,197,224,0.10)_35%,transparent_70%)]">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center justify-between gap-12">
          <div class="md:w-3/5 space-y-6">
            <p class="text-sm font-semibold text-[#d9dde0]">Hacktoberfest Hack Day Dubai x Legesher</p>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white">
              Learning + Building today for <span class="text-gradient">a better digital future</span>
            </h1>
            <p class="text-lg md:text-xl text-[#d9dde0]">
              Use this page as a reference throughout the hack day. Stay curious!
            </p>
            <p class="text-[#d9dde0]">
              Friday, October 30 · 2:30 to 8 PM (Dubai time) · Open Stage, DIFC Innovation Hub
            </p>
            <div class="flex flex-col sm:flex-row items-start gap-4">
              <ButtonLink href="#challenges" variant="default" size="lg" class="secondary-button">
                See the challenges
              </ButtonLink>
              <ButtonLink href="#submit" variant="default" size="lg" class="primary-button">
                Submit your project
              </ButtonLink>
            </div>
          </div>
          <div class="md:w-2/5 flex justify-center">
            <div class="relative">
              <div class="absolute -top-10 -left-10 w-40 h-40 bg-brand-coral/10 rounded-full blur-3xl"></div>
              <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-brand-cyan/10 rounded-full blur-3xl"></div>
              <img
                src="/HighFlyingPeggy@4x.png"
                alt="Peggy the ostrich running in an aviator cap"
                class="relative w-48 md:w-64 lg:w-72"
                width="1690"
                height="2448"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="welcome" class="py-24 bg-[#1e1e1e] scroll-mt-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Welcome to <span class="text-gradient">Hack Day</span></h2>
          <p class="text-lg text-[#d9dde0]">
            We're so excited to welcome you to Hacktoberfest Hack Day Dubai x Legesher! Check-in will start at 2:30. Come with an idea, a team or neither, and no technical experience is required. Bring your laptop, your charger and your curiosity.
          </p>
        </div>
        <div id="check-in" class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto scroll-mt-20">
          {checkIn.map((l) => (
            <a href={l.href} rel="noopener" class="group block">
              <Card className={cardClass}>
                <CardHeader>
                  <div class={tileClass}>{l.icon}</div>
                  <CardTitle>{l.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <CardDescription className="text-base text-[#d9dde0]">{l.text}</CardDescription>
                  <p class="mt-4 font-mono text-sm font-semibold text-brand-light-coral break-all">{l.url} →</p>
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
        <p class="mt-8 text-center text-lg text-[#d9dde0] max-w-3xl mx-auto">
          Be sure to get the WhatsApp community code from registration for live updates during the event.
        </p>
      </div>
    </section>

    <!-- The board's own background is brand background-coral, so the image sits flush. -->
    <section id="build-together" class="py-16 bg-brand-background-coral scroll-mt-20">
      <div class="container mx-auto px-4">
        <img
          src="/hackday-dubai/build-together.webp"
          alt="Build Together: find your team, solidify your idea. Six themes to build around: Language and Voice (under-resourced languages, voice, translation, community archives and heritage); Health and Community (health, caregiving, accessibility, education, humanitarian work, crisis response); Sustainability (climate, energy, water, food, cities); Safety (privacy, security, digital rights, fact-checking); Open Tech (developer tools, open models, small and on-device AI, decentralized tech); and Other (art, games, music, bring your own idea). Add a dot sticker in your color to your name tag to find people you might enjoy building with. No team yet? Talk to us at the registration table and we'll get you connected."
          class="mx-auto w-full max-w-5xl"
          width="1600"
          height="1131"
          loading="lazy"
        />
      </div>
    </section>

    <section id="schedule" class="py-24 bg-[#1e1e1e] scroll-mt-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Today's Schedule</h2>
          <p class="text-lg text-[#d9dde0]">All times are Dubai time.</p>
        </div>
        <Card className="max-w-2xl mx-auto bg-[#2d2d2d] border-[#424242] text-white">
          <CardContent className="p-0">
            <ol class="divide-y divide-[#424242]">
              {schedule.map((row) => (
                <li class="grid grid-cols-1 sm:grid-cols-[160px_1fr] gap-1 sm:gap-4 px-6 py-4">
                  <span class="font-mono text-sm font-semibold text-[#d9dde0]">{row.time}</span>
                  <span class="text-lg font-medium">
                    {row.highlight ? <mark class="bg-brand-yellow px-2 text-neutral-900">{row.label}</mark> : row.label}
                  </span>
                </li>
              ))}
            </ol>
          </CardContent>
        </Card>
        <p class="mt-6 max-w-2xl mx-auto text-center text-sm text-[#d9dde0]">
          By attending, you agree to the <a href={MLH_CODE_OF_CONDUCT} rel="noopener" class="text-brand-light-coral hover:text-brand-cyan underline underline-offset-4 transition-colors duration-300">MLH Code of Conduct</a>, which keeps this event a safe space for everyone. To report an issue, email <a href="mailto:incidents@mlh.io" class="text-brand-light-coral hover:text-brand-cyan underline underline-offset-4 transition-colors duration-300">incidents@mlh.io</a> or find an organizer on site.
        </p>
      </div>
    </section>

    <section id="submit" class="py-24 bg-[#272727] scroll-mt-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Submit Your Project</h2>
          <p class="text-lg text-[#d9dde0]">
            Projects are due at 7:00 PM. However far you get, we want to see your work, and one project can enter more than one challenge.
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {submit.map((l) => (
            <a href={l.href} rel="noopener" class="group block">
              <Card className={cardClass}>
                <CardHeader>
                  <div class={tileClass}>{l.icon}</div>
                  <CardTitle>{l.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <CardDescription className="text-base text-[#d9dde0]">{l.text}</CardDescription>
                  <p class="mt-4 font-mono text-sm font-semibold text-brand-light-coral break-all">{l.url} →</p>
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="challenges" class="py-24 bg-[#1e1e1e] scroll-mt-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">The Challenges</h2>
          <p class="text-lg text-[#d9dde0]">Four challenges are on the board today. Tag each one you enter when you submit.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {challenges.map((c) => (
            <Card className="group h-full flex flex-col bg-[#2d2d2d] border-[#424242] text-white transition-all duration-300 hover:shadow-lg hover:border-brand-light-cyan">
              <CardHeader>
                <div class={tileClass}>{c.icon}</div>
                <p class="text-sm font-semibold text-[#d9dde0]">Sponsored by {c.sponsor}</p>
                <CardTitle className="text-2xl">{c.title}</CardTitle>
              </CardHeader>
              <CardContent className="flex flex-1 flex-col gap-4">
                <CardDescription className="text-base text-[#d9dde0]">{c.body}</CardDescription>
                <p class="text-base">
                  <span class="font-semibold">Prize: </span>{c.prize}
                </p>
                <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-2 text-sm font-semibold">
                  {c.resources.map((r) => (
                    <a href={r.href} rel="noopener" class="text-brand-light-coral hover:text-brand-cyan underline underline-offset-4 transition-colors duration-300">{r.label}</a>
                  ))}
                  <a href={c.details} rel="noopener" class="text-brand-light-coral hover:text-brand-cyan underline underline-offset-4 transition-colors duration-300">Challenge details</a>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <section id="perks" class="py-24 bg-[#272727] scroll-mt-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Perks and Community</h2>
          <p class="text-lg text-[#d9dde0]">Hacktoberfest runs all October. Keep building after today.</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {perks.map((l) => (
            <a href={l.href} rel="noopener" class="group block">
              <Card className={cardClass}>
                <CardHeader>
                  <div class={tileClass}>{l.icon}</div>
                  <CardTitle>{l.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <CardDescription className="text-base text-[#d9dde0]">{l.text}</CardDescription>
                  <p class="mt-4 font-mono text-sm font-semibold text-brand-light-coral break-all">{l.url} →</p>
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="legesher" class="py-24 bg-[#1e1e1e] scroll-mt-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Keep Building With <span class="text-gradient">Legesher</span></h2>
          <p class="text-lg text-[#d9dde0]">Born at a hackathon, thriving at Hacktoberfests.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {legesher.map((l) => (
            <a href={l.href} rel="noopener" class="group block">
              <Card className={cardClass}>
                <CardHeader>
                  <div class={tileClass}>{l.icon}</div>
                  <CardTitle>{l.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <CardDescription className="text-base text-[#d9dde0]">{l.text}</CardDescription>
                  <p class="mt-4 font-mono text-sm font-semibold text-brand-light-coral break-all">{l.url} →</p>
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="help" class="py-24 bg-[#272727] scroll-mt-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Help and Feedback</h2>
          <p class="text-lg text-[#d9dde0]">
            Need a hand? Find Josh Edgar on site. To report a code of conduct issue, email incidents@mlh.io.
          </p>
        </div>
        <div class="max-w-md mx-auto">
          {help.map((l) => (
            <a href={l.href} rel="noopener" class="group block">
              <Card className={cardClass}>
                <CardHeader>
                  <div class={tileClass}>{l.icon}</div>
                  <CardTitle>{l.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <CardDescription className="text-base text-[#d9dde0]">{l.text}</CardDescription>
                  <p class="mt-4 font-mono text-sm font-semibold text-brand-light-coral break-all">{l.url} →</p>
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <div class="relative z-0 bg-[#272727] text-white [&_footer_.bg-gradient-to-b]:from-[#272727]">
    <Footer />
  </div>
</Layout>
