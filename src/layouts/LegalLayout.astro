---
// The legal-center layout for the documents in src/content/legal. The top of
// the page holds only the title and a button that downloads the PDF; the
// document's details (effective date, type, audience, language) sit in a
// plain list on the right from xl, and above the document between lg and xl
// so the text keeps a readable width. A numbered list of the sections runs
// down the left from lg, and folds into "On this page" below it. The columns
// sit in the site header's container, so the section list lines up with the
// logo, and the text is centred in the middle column at a reading width. The section
// list is built from the document's level-2 headings, which carry fixed ids
// (src/lib/legal-content.test.ts); the built-page checks are
// src/lib/legal-built.test.ts. The PDF is this page's print version, made by
// scripts/legal-pdfs.mjs (src/lib/legal-pdf.mjs).
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { FileText, Scale } from 'lucide-react';
import { formatLastUpdated } from '@/lib/page-dates.mjs';
import { pdfHref } from '@/lib/legal-pdf.mjs';

interface Props {
  entry: CollectionEntry<'legal'>;
  headings: MarkdownHeading[];
  /** ISO date, from LAST_UPDATED[<id>]. */
  lastUpdated: string;
  /** The full <title>, exactly as the page has always had it. */
  pageTitle: string;
}

const { entry, headings, lastUpdated, pageTitle } = Astro.props;
const { title, description, type, audience } = entry.data;
const date = formatLastUpdated(lastUpdated);

// Each section is listed by its own number ("4. Payments" as 04 Payments); a
// section without one (an appendix) is listed without a number.
const sections = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => {
    const numbered = /^(\d+)\.\s*(.*)$/.exec(heading.text);
    return {
      slug: heading.slug,
      number: numbered ? numbered[1].padStart(2, '0') : '',
      text: numbered ? numbered[2] : heading.text,
    };
  });

// One brand tint per audience, so a document for one audience reads apart at a glance.
const AUDIENCE_TINT: Record<string, string> = {
  'All users': 'bg-brand-background-cyan',
  Individual: 'bg-brand-light-yellow',
  Business: 'bg-brand-background-coral',
};
// The icon on the type tag: a balance for terms, a page for a policy.
const TYPE_ICON = { Terms: Scale, Policy: FileText } as const;
const TypeIcon = TYPE_ICON[type];
const TAG = 'inline-flex items-center rounded px-2 py-0.5 text-xs font-medium text-gray-900';
const ROW = 'grid grid-cols-[5.5rem_minmax(0,1fr)] gap-x-4 items-center border-t border-gray-200 py-3';
---

<Layout title={pageTitle} description={description}>
  <Header />
  <main class="pt-16 pb-20 bg-white print:p-0">
    <section data-legal-hero class="container mx-auto px-4 flex flex-col items-center text-center pt-24 pb-16 md:pt-32 md:pb-24 print:items-start print:text-left print:p-0 print:pb-6">
      <h1 class="font-display text-4xl md:text-6xl font-bold tracking-tight text-gray-900">{title}</h1>
      <ButtonLink href={pdfHref(entry.id)} download size="lg" class="secondary-button mt-8 gap-2 print:hidden">
        Download PDF
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
      </ButtonLink>
    </section>

    <div class="container mx-auto px-4 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-x-16 xl:grid-cols-[13rem_minmax(0,1fr)_17rem] 2xl:gap-x-24 print:block print:max-w-none print:p-0">
      <aside aria-label="Document details" class="mb-8 lg:col-start-2 lg:row-start-1 lg:mx-auto lg:w-full lg:max-w-[44rem] xl:mx-0 xl:mb-0 xl:max-w-none xl:col-start-3 xl:sticky xl:top-28 xl:self-start print:mb-6 print:max-w-none">
        <dl class="text-sm border-b border-gray-200">
          <div class={ROW}>
            <dt class="text-gray-500">Effective</dt>
            <dd class="text-gray-900">{date}</dd>
          </div>
          <div class={ROW}>
            <dt class="text-gray-500">Type</dt>
            <dd data-type>
              <span class={`${TAG} gap-1.5 bg-gray-100`}>
                <TypeIcon className="h-3.5 w-3.5 text-gray-600" aria-hidden="true" data-icon={type.toLowerCase()} />
                {type}
              </span>
            </dd>
          </div>
          <div class={ROW}>
            <dt class="text-gray-500">Audience</dt>
            <dd data-audience>
              <span class={`${TAG} ${AUDIENCE_TINT[audience]}`}>{audience}</span>
            </dd>
          </div>
          <div class={ROW}>
            <dt class="text-gray-500">Language</dt>
            <dd class="text-gray-900">English</dd>
          </div>
        </dl>
      </aside>

      <details class="lg:hidden mb-8 border-y border-gray-200 print:hidden">
        <summary class="cursor-pointer py-3 text-sm font-medium text-gray-900">On this page</summary>
        <ol class="pb-3 text-sm">
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`} class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 py-1.5 text-gray-800 hover:text-brand-cyan transition-colors duration-300">
                <span class="font-mono text-xs text-gray-500 pt-0.5">{section.number}</span>
                <span>{section.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>

      <nav aria-label="Sections" class="hidden lg:block lg:col-start-1 lg:row-start-1 lg:row-span-2 xl:row-span-1 lg:sticky lg:top-28 lg:self-start lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto print:hidden">
        <ol class="text-sm border-b border-gray-200">
          {sections.map((section) => (
            <li class="border-t border-gray-200">
              <a href={`#${section.slug}`} class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 py-3 text-gray-800 hover:text-brand-cyan transition-colors duration-300">
                <span class="font-mono text-xs text-gray-500 pt-0.5">{section.number}</span>
                <span>{section.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <article class="legal-document min-w-0 lg:mx-auto lg:w-full lg:max-w-[44rem] lg:col-start-2 lg:row-start-2 xl:row-start-1 prose max-w-none text-gray-800 prose-headings:text-gray-900 prose-headings:font-semibold prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-2 prose-p:my-3 prose-p:leading-normal prose-li:my-1 prose-li:leading-normal prose-ul:my-3 prose-ol:my-3 prose-a:text-brand-cyan hover:prose-a:text-brand-coral prose-table:text-sm prose-table:my-4">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Keep heading anchors clear of the fixed header on in-page navigation */
  :global(main h2[id]),
  :global(main h3[id]) {
    scroll-margin-top: 6rem;
  }
  /* The first section starts level with the two lists beside it */
  .legal-document > :global(:first-child) {
    margin-top: 0;
  }
  /* Legal tables sit on the brand's light blue (background-cyan), with a
     deeper header row, white lines between rows and padding on every side */
  .legal-document :global([data-legal-table]) {
    margin: 1rem 0;
    border-radius: 0.5rem;
  }
  .legal-document :global([data-legal-table] table) {
    margin: 0;
    background-color: #e8f6fd;
  }
  .legal-document :global([data-legal-table] thead) {
    background-color: #d3eef9;
    border-bottom: 0;
  }
  .legal-document :global([data-legal-table] th),
  .legal-document :global([data-legal-table] td) {
    padding: 0.625rem 0.75rem;
  }
  .legal-document :global([data-legal-table] tbody tr) {
    border-bottom-color: #ffffff;
  }
  /* Code names (the cookie names) show without the backticks the
     typography plugin draws around inline code */
  .legal-document :global(code::before),
  .legal-document :global(code::after) {
    content: none;
  }
  /* A table whose cells hold lists (Privacy, Legal Bases): the lists sit
     tight in their cells, and the columns are set so a short item such as
     "Identity and Contact Data" keeps to one line on a wide screen */
  .legal-document :global(td ul) {
    margin: 0;
    padding-left: 1rem;
  }
  .legal-document :global(td li) {
    margin: 0;
    padding-left: 0;
  }
  .legal-document :global(table:has(td ul) th:nth-child(1)) {
    width: 44%;
  }
  .legal-document :global(table:has(td ul) th:nth-child(2)) {
    width: 31%;
  }
  .legal-document :global(table:has(td ul) th:nth-child(3)) {
    width: 25%;
  }
  /* The PDF is this page printed: no site header or footer */
  @media print {
    :global(#main-header),
    :global(body > footer) {
      display: none !important;
    }
    .legal-document {
      font-size: 10.5pt;
    }
    /* A heading never ends a page without its first lines */
    .legal-document :global(h2),
    .legal-document :global(h3) {
      break-after: avoid;
    }
  }
</style>
