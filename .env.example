# Buttondown Newsletter Configuration
BUTTONDOWN_URL=https://buttondown.email/api/emails/embed-subscribe/YOUR_NEWSLETTER_ID
BUTTONDOWN_API_KEY=your_api_key_here

# PostHog project token for the newsletter funnel (public by design; CORE-1948).
# Leave empty to build without analytics: the loader is not rendered and the
# Content Security Policy is not widened.
PUBLIC_POSTHOG_KEY=
